[Unit]
Description=NetWatch Celery Beat Scheduler
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/netwatch/backend
EnvironmentFile=/etc/netwatch/netwatch.env
ExecStart=/srv/netwatch/venv/bin/celery -A backend beat --loglevel=INFO --schedule=/var/lib/netwatch/celerybeat-schedule
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
