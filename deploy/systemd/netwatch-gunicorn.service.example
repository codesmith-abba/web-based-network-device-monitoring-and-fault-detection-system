[Unit]
Description=NetWatch Django Gunicorn
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/netwatch/backend
EnvironmentFile=/etc/netwatch/netwatch.env
ExecStart=/srv/netwatch/venv/bin/gunicorn backend.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
