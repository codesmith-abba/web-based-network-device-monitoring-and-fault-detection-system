server {
    listen 80;
    listen [::]:80;
    server_name localhost 127.0.0.1;

    root /home/codesmithabba/Desktop/web-based-network-device-monitoring-and-fault-detection-system/frontend/dist;
    index index.html;

    client_max_body_size 10m;

    location /static/ {
        alias /home/codesmithabba/Desktop/web-based-network-device-monitoring-and-fault-detection-system/backend/staticfiles/;
        access_log off;
        expires 1d;
    }

    location /media/ {
        alias /home/codesmithabba/Desktop/web-based-network-device-monitoring-and-fault-detection-system/backend/media/;
        access_log off;
        expires 1d;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /admin/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
