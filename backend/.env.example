# Production: generate a unique secret and never commit the real value.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_TIME_ZONE=UTC
SQLITE_DB_PATH=/srv/netwatch/backend/db.sqlite3
DJANGO_STATIC_ROOT=/srv/netwatch/backend/staticfiles
DJANGO_MEDIA_ROOT=/srv/netwatch/backend/media

# Same-origin production deployment normally needs no cross-origin API access.
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com

# Enable these only when Nginx/TLS serves the application over HTTPS.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
